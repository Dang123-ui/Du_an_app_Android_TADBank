<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollStatement"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="96dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootStatement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvStatementTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Sao kê tài khoản Checking"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
            android:textColor="#c22449"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStatementSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Chọn tài khoản và khoảng thời gian để xuất sao kê Excel/PDF."
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="#6b6b6b"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatementTitle" />

        <!-- Card: Filters -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatementFilters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvStatementSubtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Account dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAccount"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:hint="Tài khoản checking"
                    app:endIconMode="dropdown_menu"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/actCheckingAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:textColor="#1c1b1f"
                        tools:text="****1234 - Main Checking" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Guideline 50% -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineMid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- From date (calendar-like field) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilFromDate"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Từ ngày"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_chevron_down"
                    app:endIconContentDescription="Chọn ngày"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMid"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilAccount">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtFromDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:textColor="#1c1b1f"
                        android:textIsSelectable="false"
                        tools:text="01/12/2025" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- To date (calendar-like field) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilToDate"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="Đến ngày"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_chevron_down"
                    app:endIconContentDescription="Chọn ngày"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidelineMid"
                    app:layout_constraintTop_toBottomOf="@id/tilAccount">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtToDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="false"
                        android:importantForAutofill="no"
                        android:inputType="none"
                        android:textColor="#1c1b1f"
                        android:textIsSelectable="false"
                        tools:text="21/12/2025" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Quick range chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRange"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:selectionRequired="false"
                    app:singleSelection="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tilFromDate">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip7d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="7 ngày" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip30d"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30 ngày" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tất cả" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Info -->
                <TextView
                    android:id="@+id/tvHint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Gợi ý: Chọn 30 ngày để xuất nhanh, hoặc chọn khoảng tùy chỉnh."
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="#6b6b6b"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chipGroupRange" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Actions -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatementActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardStatementFilters">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvActionsTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Xuất sao kê"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textColor="#1c1b1f"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guidelineMid2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportExcel"
                    style="@style/Widget.Material3.Button.FilledButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Xuất Excel (.xlsx)"
                    app:icon="@drawable/ic_excel"
                    app:iconPadding="8dp"
                    app:layout_constraintEnd_toStartOf="@id/guidelineMid2"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvActionsTitle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportPdf"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Xuất PDF"
                    app:icon="@drawable/ic_pdf"
                    app:iconPadding="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/guidelineMid2"
                    app:layout_constraintTop_toBottomOf="@id/tvActionsTitle" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressExport"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnExportExcel" />

                <TextView
                    android:id="@+id/tvExportStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=" "
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="#6b6b6b"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/progressExport" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
