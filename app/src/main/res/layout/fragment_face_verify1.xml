<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00000000"
    android:backgroundTint="#00000000"
    tools:context=".ui.fragment.FaceVerify1Fragment">

    <!-- TODO: Update blank fragment layout -->


    <TextView
        android:id="@+id/textView18"
        android:layout_width="208dp"
        android:layout_height="48dp"
        android:layout_marginStart="112dp"
        android:layout_marginTop="44dp"
        android:gravity="center"
        android:text="Mặt đúng vị trí giữ vững tay"
        android:textColor="#C32349"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgPicture" />

    <ImageView
        android:id="@+id/imgPicture"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginStart="88dp"
        android:layout_marginTop="136dp"
        android:background="@drawable/ic_scan_cus"
        android:clipToOutline="true"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_signup_face_recognition"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView18" />

    <ImageView
        android:id="@+id/imageView18"
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:layout_marginStart="160dp"
        android:layout_marginTop="16dp"
        android:transitionName="app_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <ImageButton
        android:id="@+id/btnTakePhoto"
        android:layout_width="57dp"
        android:layout_height="53dp"
        android:layout_marginStart="152dp"
        android:layout_marginTop="200dp"
        android:background="#00000000"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_signup_camera"
        app:layout_constraintStart_toStartOf="@+id/imgPicture"
        app:layout_constraintTop_toTopOf="@+id/imgPicture" />

    <ImageButton
        android:id="@+id/btnFile"
        android:layout_width="57dp"
        android:layout_height="53dp"
        android:layout_marginStart="36dp"
        android:layout_marginTop="200dp"
        android:background="#00000000"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_image_file"
        app:layout_constraintEnd_toStartOf="@+id/btnTakePhoto"
        app:layout_constraintHorizontal_bias="0.277"
        app:layout_constraintStart_toStartOf="@+id/imgPicture"
        app:layout_constraintTop_toTopOf="@+id/imgPicture"/>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/success"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginTop="176dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.563"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/imgPicture"
        app:layout_constraintVertical_bias="0.006"
        app:lottie_autoPlay="false"
        app:lottie_loop="false"
        app:lottie_rawRes="@raw/checkmark" />

</androidx.constraintlayout.widget.ConstraintLayout>