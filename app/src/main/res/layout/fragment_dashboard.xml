<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ui.fragment.officer.DashboardFragment"
    tools:theme="@style/Theme.Material3.Light.NoActionBar">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dashboardRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textColor="#FF0000"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipFilters"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipToday"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="true"
                android:text="Today"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                android:textSize="14sp"
                app:checkedIcon="@null"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeWidth="0dp"
                app:rippleColor="@color/chip_ripple" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip7d"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="false"
                android:text="7 ngày"
                android:textColor="@color/chip_text_selector"
                app:checkedIcon="@null"
                app:checkedIconTint="@null"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip30d"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="false"
                android:text="30 ngày"
                android:textColor="@color/chip_text_selector"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeWidth="0dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAllChannels"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:checkable="true"
                android:checked="false"
                android:text="All"
                android:textAlignment="center"
                android:textColor="@color/chip_text_selector"
                app:chipBackgroundColor="@color/chip_bg"
                app:chipStrokeWidth="0dp" />
        </com.google.android.material.chip.ChipGroup>

        <HorizontalScrollView
            android:id="@+id/hsCards"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:overScrollMode="never"
            android:scrollbars="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipFilters">

            <LinearLayout
                android:id="@+id/rowCards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ========= Card 1: Số người dùng ========= -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardUsers"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginRight="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvUsersTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Người dùng"
                            android:textColor="#FF0303"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvValueUserOnl"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="30dp"
                            android:layout_marginTop="15dp"
                            android:text="12,450"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvUsersTitle2" />
                        <TextView
                            android:id="@+id/tvOnline2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Onl"
                            android:textColor="#FF0303"
                            android:textStyle="normal"
                            app:layout_constraintEnd_toStartOf="@+id/tvValueUserOnl"
                            app:layout_constraintHorizontal_bias="0.444"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvUsersTitle2" />

                        <TextView
                            android:id="@+id/tvOff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="40dp"
                            android:text="Off"
                            android:textColor="#FF0303"
                            android:textStyle="normal"
                            app:layout_constraintEnd_toStartOf="@+id/tvValueUserOnl"
                            app:layout_constraintHorizontal_bias="0.444"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvUsersTitle2" />

                        <ImageView
                            android:id="@+id/imgUsers"
                            android:layout_width="52dp"
                            android:layout_height="63dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/ic_user"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvValueOff"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="30dp"
                            android:layout_marginTop="5dp"
                            android:text="12,450"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/tvValueUserOnl" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ========= KPI 1: DAU (tím) ========= -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKpi1"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginRight="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient_purple"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvKpi1Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="DAU"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/imgKpi1"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imgKpi1"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_user"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKpi1Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12,450"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvKpi1Title" />

                        <TextView
                            android:id="@+id/tvKpi1Delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_delta_positive"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="+5.2%"
                            android:textColor="#5DFF00"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvKpi1Value"
                            app:layout_constraintStart_toEndOf="@id/tvKpi1Value" />

                        <View
                            android:id="@+id/spark1"
                            android:layout_width="0dp"
                            android:layout_height="26dp"
                            android:background="#26FFFFFF"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKpi2"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginRight="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient_blue"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvKpi2Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="GVM"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/imgKpi2"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imgKpi2"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_user"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKpi2Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12,450"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvKpi2Title" />

                        <TextView
                            android:id="@+id/tvKpi2Delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_delta_positive"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="+5.2%"
                            android:textColor="#5DFF00"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvKpi2Value"
                            app:layout_constraintStart_toEndOf="@id/tvKpi2Value" />

                        <View
                            android:id="@+id/spark2"
                            android:layout_width="0dp"
                            android:layout_height="26dp"
                            android:background="#26FFFFFF"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKpi3"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginRight="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient_green"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvKpi3Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Giao dịch"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/imgKpi3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imgKpi3"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_user"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKpi3Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12,450"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvKpi3Title" />

                        <TextView
                            android:id="@+id/tvKpi3Delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_delta_positive"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="+5.2%"
                            android:textColor="#5DFF00"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvKpi3Value"
                            app:layout_constraintStart_toEndOf="@id/tvKpi3Value" />

                        <View
                            android:id="@+id/spark3"
                            android:layout_width="0dp"
                            android:layout_height="26dp"
                            android:background="#26FFFFFF"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKpi4"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginRight="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient_dream"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvKpi4Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Người dùng mới"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/imgKpi4"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imgKpi4"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_user"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKpi4Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12,450"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvKpi4Title" />

                        <TextView
                            android:id="@+id/tvKpi4Delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_delta_positive"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="+5.2%"
                            android:textColor="#5DFF00"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvKpi4Value"
                            app:layout_constraintStart_toEndOf="@id/tvKpi4Value" />

                        <View
                            android:id="@+id/spark4"
                            android:layout_width="0dp"
                            android:layout_height="26dp"
                            android:background="#26FFFFFF"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKpi5"
                    style="@style/Widget.Material3.CardView.Outlined"
                    android:layout_width="200dp"
                    android:layout_height="120dp"
                    android:layout_marginRight="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_card_gradient_red"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvKpi5Title"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="Tỉ lệ thất bại"
                            android:textColor="#FFFFFF"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/imgKpi5"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imgKpi5"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_user"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKpi5Value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="12,450"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvKpi5Title" />

                        <TextView
                            android:id="@+id/tvKpi5Delta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_delta_positive"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:text="+5.2%"
                            android:textColor="#5DFF00"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="@id/tvKpi5Value"
                            app:layout_constraintStart_toEndOf="@id/tvKpi5Value" />

                        <View
                            android:id="@+id/spark5"
                            android:layout_width="0dp"
                            android:layout_height="26dp"
                            android:background="#26FFFFFF"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Chart line placeholder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChartLine"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hsCards">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvChart1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GMV theo thời gian"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartLinePlaceholder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintTop_toBottomOf="@id/tvChart1Title"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Chart bar placeholder -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardChartBar"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardChartLine">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvChart2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Top phân bổ (Bar ngang)"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/chartBarPlaceholder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvChart2Title" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ========= HTML 1: Failure Rate by Cause ========= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFailureRate"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardChartBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvFailureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Failure Rate by Cause"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"/>

                </LinearLayout>
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/failurePlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ========= HTML 2: Account Opening Funnel ========= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAccountFunnel"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardFailureRate">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvFunnelTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Account Opening Funnel"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <com.github.mikephil.charting.charts.HorizontalBarChart
                    android:id="@+id/accountFunnel"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ========= HTML 3: AI Insights ========= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAiInsights"
            style="@style/Widget.Material3.CardView.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardAccountFunnel">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/loading"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:visibility="visible"
                        app:lottie_autoPlay="true"
                        app:lottie_loop="true"
                        app:lottie_rawRes="@raw/ailoading" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="AI Insights"
                        android:textColor="#C32349"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="•"
                            android:textColor="#6B7280" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="GMV increased by 5.2% in the last 30 days, driven by mobile app transactions."
                            android:textColor="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="•"
                            android:textColor="#6B7280" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:text="Recommend promoting the new loan feature to boost engagement."
                            android:textColor="#4B5563"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAskAi"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Ask AI"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    app:backgroundTint="#C32349" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
