<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.activity.OfficerMainActivity"
    android:background="@drawable/bg_main">

    <TextView
        android:id="@+id/textView25"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="16dp"
        android:text="Xin chào:"
        android:textColor="#F6F3F3"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvNameOfficer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="16dp"
        android:text="D"
        android:textColor="#F6F3F3"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/textView25"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/imbtLogout1"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:background="@drawable/ic_home_logout2"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/officer_container_card"
        android:layout_width="match_parent"
        android:layout_height="756dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="-25dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav_officer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView25"
        app:layout_constraintVertical_bias="1"
        app:shapeAppearanceOverlay="@style/TopRoundedCard">
        <!-- container fragment -->
        <FrameLayout
            android:id="@+id/officer_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.nafis.bottomnavigation.NafisBottomNavigation
        android:id="@+id/bottom_nav_officer"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:mbn_selectedIconColor="@color/white"
        app:mbn_backgroundBottomColor="@color/white"
        app:mbn_circleColor="@color/primaryColor"
        app:mbn_rippleColor="#000000"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
    <View
        android:id="@+id/loginRevealOverlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#FFC7D5"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

</androidx.constraintlayout.widget.ConstraintLayout>