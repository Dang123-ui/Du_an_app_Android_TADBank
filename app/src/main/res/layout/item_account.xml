<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:layout_marginBottom="16dp"
    >
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        >

        <TextView
            android:id="@+id/tvUserName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Nguyễn Hải Đăng"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:textColor="#1c1b1f"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ivExpand"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvUserId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="52300096"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:textColor="#6b6b6b"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvUserName" />

        <ImageView
            android:id="@+id/ivExpand"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Expand"
            app:layout_constraintBottom_toBottomOf="@+id/tvUserName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_expand" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chipContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvUserId">

            <FrameLayout
                android:id="@+id/frameBadgeChecking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipChecking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Checking" />

                <TextView
                    android:id="@+id/txtBadgeChecking"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_circle_red"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameBadgeSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSaving"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Savings" />

                <TextView
                    android:id="@+id/txtBadgeSaving"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_circle_red"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/frameBadgeMortgage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMortgage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mortgage" />

                <TextView
                    android:id="@+id/txtBadgeMortgage"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_circle_red"
                    android:gravity="center"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Flow: tự wrap xuống dòng nếu không đủ chỗ -->
            <androidx.constraintlayout.helper.widget.Flow
                android:id="@+id/chipFlow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="frameBadgeChecking,frameBadgeSaving,frameBadgeMortgage"
                app:flow_wrapMode="chain"
                app:flow_horizontalGap="12dp"
                app:flow_verticalGap="8dp"
                app:flow_horizontalStyle="packed"
                app:flow_firstHorizontalStyle="packed"
                app:flow_lastHorizontalStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="12dp"
            android:background="#656667"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/chipContainer"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/detailsContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/divider">
            <TextView
                android:id="@+id/tvPhoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone:"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@color/black"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="+84706613468"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#1c1b1f"
                app:layout_constraintStart_toEndOf="@id/tvPhoneLabel"
                app:layout_constraintEnd_toStartOf="@id/bmbAccounts"
                app:layout_constraintTop_toTopOf="@id/tvPhoneLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvPhoneLabel"
                />

            <com.nightonke.boommenu.BoomMenuButton
                android:id="@+id/bmbAccounts"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                app:bmb_buttonEnum="ham"
                app:bmb_buttonPlaceEnum="buttonPlace_ham_5"
                app:bmb_piecePlaceEnum="piecePlace_ham_5"
                app:layout_constraintBottom_toBottomOf="@id/tvPhoneLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPhone"
                app:layout_constraintTop_toTopOf="@id/tvPhoneLabel"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/tvEmailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Email:"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#1c1b1f"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvPhoneLabel"/>

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:text="dang0582366729@gmail.com"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#1c1b1f"
                app:layout_constraintEnd_toStartOf="@+id/bmbAccounts"
                app:layout_constraintStart_toEndOf="@id/tvEmailLabel"
                app:layout_constraintTop_toBottomOf="@id/tvPhone" />

            <TextView
                android:id="@+id/tvSectionChecking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="#c22449"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvEmail" />

            <TextView
                android:id="@+id/tvCheckingAccounts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="****1111\n****2222\n****3333"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#1c1b1f"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionChecking"/>
            <TextView
                android:id="@+id/tvCheckingTotal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="💰 Tổng số dư: 15,250,000 VND"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#c22449"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCheckingAccounts"/>
            <TextView
                android:id="@+id/tvSectionSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Saving"
                android:textStyle="bold"
                android:textColor="#c22449"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCheckingTotal"/>
            <TextView
                android:id="@+id/tvSectionSavings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="📊 3 sổ tiết kiệm (2 có kỳ hạn, 1 không kỳ hạn)\n💰 Tổng số dư: 250,000,000 VND\n📈 Sổ cao nhất: 150,000,000 VND (SAV_6M_FIX)\n🟢 2/3 sổ đang hoạt động"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#1c1b1f"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionSaving"/>
            <TextView
                android:id="@+id/tvSectionMortgage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Mortgage"
                android:textStyle="bold"
                android:textColor="#c22449"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionSavings"/>
            <TextView
                android:id="@+id/tvSectionMortgages"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🏠 2 khoản vay thế chấp\n💰 Tổng dư nợ: 2,500,000,000 VND\n⚠️ Quá hạn: 45,000,000 VND (1 khoản)\n📅 Đến hạn gần nhất: 15,000,000 VND (15/12/2025)\n📈 Khoản vay lớn nhất: 1,800,000,000 VND"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="#1c1b1f"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvSectionMortgage"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>