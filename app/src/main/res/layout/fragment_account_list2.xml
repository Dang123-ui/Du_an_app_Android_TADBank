<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.fragment.officer.AccountListOfficerFragment"
    android:padding="16dp">
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Account List"
        android:textColor="#FF0000"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/search_card"
        style="@style/Widget.Material3.CardView.Elevated"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="28dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ic_leading_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tìm kiếm khách hàng"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Tìm kiếm"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOutline"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/ic_leading_search"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipFilters1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:singleLine="true"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_card">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipToday1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="false"
            android:text="Today"
            android:textAlignment="center"
            android:textColor="@color/chip_text_selector"
            android:textSize="14sp"
            app:checkedIcon="@null"
            app:checkedIconVisible="false"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipStrokeWidth="0dp"
            app:rippleColor="@color/chip_ripple" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip7d_"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="false"
            android:text="7 ngày"
            android:textColor="@color/chip_text_selector"
            app:checkedIcon="@null"
            app:checkedIconTint="@null"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chip30d_"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="false"
            android:text="30 ngày"
            android:textColor="@color/chip_text_selector"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipAllChannels1"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:checkable="true"
            android:checked="true"
            android:text="All"
            android:textAlignment="center"
            android:textColor="@color/chip_text_selector"
            app:chipBackgroundColor="@color/chip_bg"
            app:chipStrokeWidth="0dp" />
    </com.google.android.material.chip.ChipGroup>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAccounts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipFilters1"
        tools:itemCount="4"
        tools:listitem="@layout/item_account" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/emptyLottie"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chipFilters1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/lighthouse" />
    <TextView
        android:id="@+id/emptyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Không có kết quả. Nhập từ khóa để tìm kiếm"
        android:textSize="14sp"
        android:textColor="?attr/colorOutline"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/emptyLottie"
        app:layout_constraintStart_toStartOf="@id/rvAccounts"
        app:layout_constraintEnd_toEndOf="@id/rvAccounts"
        android:layout_marginTop="8dp" />


</androidx.constraintlayout.widget.ConstraintLayout>