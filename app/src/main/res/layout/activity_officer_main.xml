<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_main"
    tools:context=".ui.activity.OfficerMainActivity">

    <!-- Guideline top cho khoảng cách ổn định -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_begin="16dp" />

    <!-- Header row: Xin chào + tên (co giãn) + logout -->
    <LinearLayout
        android:id="@+id/headerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/guidelineTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textView25"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Xin chào:"
            android:textColor="#F6F3F3"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNameOfficer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Nguyễn Hải Đăng"
            android:textColor="#F6F3F3"
            android:textSize="20sp"
            android:textStyle="bold"
            tools:text="Nguyễn Hải Đăng" />

        <ImageButton
            android:id="@+id/imbtLogout1"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/ic_home_logout2"/>
    </LinearLayout>

    <!-- Card container: kéo xuống tận đáy để không tạo khoảng trống -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/officer_container_card"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:elevation="6dp"
        app:shapeAppearanceOverlay="@style/TopRoundedCard"
        app:layout_constraintTop_toBottomOf="@id/headerRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Container fragment -->
        <!-- paddingBottom để nội dung fragment không bị bottom nav che -->
        <FrameLayout
            android:id="@+id/officer_fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="84dp"
            android:clipToPadding="false" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom nav: đặt SAU card để nằm trên (z-order) -->
    <com.nafis.bottomnavigation.NafisBottomNavigation
        android:id="@+id/bottom_nav_officer"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:elevation="16dp"
        android:translationZ="16dp"
        app:mbn_selectedIconColor="@color/white"
        app:mbn_backgroundBottomColor="@color/white"
        app:mbn_circleColor="@color/primaryColor"
        app:mbn_rippleColor="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Overlay (center) -->
    <View
        android:id="@+id/loginRevealOverlay"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="#FFC7D5"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
