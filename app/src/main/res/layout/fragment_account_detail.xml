<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:orientation="vertical"
    android:background="@color/primaryBackgroundColor"
    tools:context=".ui.fragment.AccountDetailFragment">

    <!-- TODO: Update blank fragment layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginBottom="8dp"
            >

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/ten_tai_khoan"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

            <TextView
                android:id="@+id/txtAccountDetailAccName"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="T123567"
                android:textColor="@color/black"
                style="@style/TextAppearance.AppCompat.Title"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            >

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/so_tai_khoan"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

            <TextView
                android:id="@+id/txtAccountDetailAccNumber"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="T123567"
                android:textColor="@color/black"
                style="@style/TextAppearance.AppCompat.Title"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginBottom="8dp"
            >

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/so_du"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

            <TextView
                android:id="@+id/txtAccountDetailCurrentBalance"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="T123567"
                android:textColor="@color/black"
                style="@style/TextAppearance.AppCompat.Title"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            >

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/lai_suat"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

            <TextView
                android:id="@+id/txtAccountDetailInterestRate"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="T123567"
                android:textColor="@color/black"
                style="@style/TextAppearance.AppCompat.Title"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        >
        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_marginBottom="8dp"
            >

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/ngay_mo_tai_khoan"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

            <TextView
                android:id="@+id/txtAccountDetailOpenDate"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="T123567"
                android:textColor="@color/black"
                style="@style/TextAppearance.AppCompat.Title"
                android:textSize="16sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            >

            <TextView
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="@string/ngay_gd_gan_nhat"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <View
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_width="0dp" />

            <TextView
                android:id="@+id/txtAccountDetailDateOfLastTxn"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:text="T123567"
                android:textColor="@color/black"
                style="@style/TextAppearance.AppCompat.Title"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>
</LinearLayout>