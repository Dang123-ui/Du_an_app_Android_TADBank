<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.fragment.FaceVerifyFragment">

    <!-- TODO: Update blank fragment layout -->


    <ImageView
        android:id="@+id/imageView13"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:transitionName="app_logo"

        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <ImageView
        android:id="@+id/imageView14"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/ic_scan_cus"
        android:clipToOutline="true"
        android:padding="5dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_signup_face_recognition"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView13" />


    <TextView
        android:id="@+id/textView12BatDauChup"
        android:layout_width="210dp"
        android:layout_height="63dp"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Bắt đầu chụp ảnh để nhận diện khuôn mặt"
        android:textColor="#C32349"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView14" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"

        app:layout_constraintTop_toBottomOf="@+id/textView12BatDauChup"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            >

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"

                android:background="@drawable/ic_scan_cus"
                android:clipToOutline="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_signup_face_recognition"
                />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:textAlignment="center"
                android:paddingTop="0dp"
                android:text="Khuôn mặt nằm gọn trong khuôn hình"
                android:textSize="16sp"
                android:textStyle="bold"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            >
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"

                android:background="@drawable/ic_scan_cus"
                android:clipToOutline="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_signup_face_recognition_4"

                />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:textAlignment="center"
                android:paddingTop="0dp"
                android:text="Đảm bảo hình không quá sáng hoặc tối"
                android:textSize="16sp"
                android:textStyle="bold"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            >
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"

                android:background="@drawable/ic_scan_cus"
                android:clipToOutline="true"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_signup_face_recognition_3"

                />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_gravity="center"
                android:textAlignment="center"
                android:paddingTop="0dp"
                android:text="Không đội mũ, đeo kính hoặc khẩu trang"
                android:textSize="16sp"
                android:textStyle="bold"
                />
        </LinearLayout>

    </LinearLayout>

    <Button
        android:id="@+id/btnBatDauChup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:backgroundTint="#C32349"
        android:text="Bắt đầu chụp"
        app:cornerRadius="16dp"

        app:layout_constraintVertical_bias="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
</androidx.constraintlayout.widget.ConstraintLayout>