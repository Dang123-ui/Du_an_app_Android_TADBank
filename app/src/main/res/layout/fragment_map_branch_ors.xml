<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.fragment.customer.ggmap.MapBranchOrsFragment">

    <!--
            Zoom controls: hai nút + và - đặt ở góc dưới bên phải để zoom in/out như Google Maps.
            Sử dụng Button thường để tránh phụ thuộc icon. Bạn có thể thay bằng ImageButton và
            dùng ic_zoom_in / ic_zoom_out nếu đã có drawable tương ứng.
         -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/llZoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:background="@drawable/bg_button_outline"
        android:padding="8dp"
        android:layout_margin="16dp"
        android:orientation="vertical"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintBottom_toTopOf="@+id/cardMapNearest"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageButton
            android:id="@+id/btnZoomIn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:scaleType="centerInside"

            android:background="@drawable/ic_map_zoom_in"
            android:backgroundTint="@null"
            android:contentDescription="Focus" />

        <View
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <ImageButton
            android:id="@+id/btnZoomOut"
            android:layout_width="24dp"
            android:layout_height="24dp"

            android:background="@drawable/ic_map_zoom_out"
            android:backgroundTint="@null"
            android:contentDescription="Focus" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMapNearest"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/white"
            android:gravity="center"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnMapFocusRoute"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"

                android:background="@drawable/ic_password_eye_open"
                android:backgroundTint="@null"
                android:contentDescription="Focus" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                >
                <TextView
                    android:id="@+id/txtMapNearestName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearest branch"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtMapNearestAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minLines="1"
                    android:text="Address" />

                <TextView
                    android:id="@+id/txtMapNearestDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>